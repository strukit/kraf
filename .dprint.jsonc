{
  "plugins": [
    "https://plugins.dprint.dev/exec-0.7.3.json",
    "https://plugins.dprint.dev/json-0.23.0.wasm",
    "https://plugins.dprint.dev/markdown-0.23.3.wasm",
    "https://plugins.dprint.dev/toml-0.8.0.wasm",
    "https://plugins.dprint.dev/dockerfile-0.6.0.wasm",
  ],
  "exec": {
    "cwd": "${configDir}",
    "commands": [
      {
        "command": "rustfmt",
        "exts": ["rs"],
        "cacheKeyFiles": ["rustfmt.toml", "rust-toolchain.toml"],
      },
    ],
  },
  "json": {
    "locked": true,
    "trailingCommas": "jsonc",
  },
  "markdown": {
    "locked": true,
    "textWrap": "always",
  },
  "toml": {
    "locked": true,
  },
}
